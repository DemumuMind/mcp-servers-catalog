    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-storybook": "^10.3.6",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "storybook": "^10.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vite": "^8.0.10",
    "vitest": "^4.1.8"
