    "@libsql/win32-x64-msvc": "^0.5.29",
    "@paralleldrive/cuid2": "^3.3.0",
    "@types/dompurify": "^3.0.5",
    "@types/sanitize-html": "^2.16.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.8",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.14.0",
    "graphql-yoga": "^5.21.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.11.1",
    "next-themes": "^0.4.6",
    "node-cache": "^5.1.2",
    "nodemailer": "^8.0.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.74.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.4",
    "shadcn": "^4.6.0",
    "sharp": "^0.34.5",
