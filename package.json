{
  "name": "mcpservers-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "validate": "npm run lint && npm run typecheck && npm run test:unit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "db:seed": "tsx -r dotenv/config scripts/seed.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "rm -rf .turso && npx drizzle-kit push && tsx -r dotenv/config scripts/seed.ts",
    "db:init": "npx drizzle-kit push",
    "brand:assets": "tsx scripts/generate-brand-assets.ts",
    "brand:check": "tsx scripts/check-brand-assets.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.2",
