# Database — Turso/libsql
# Local: file:.turso/local.db
# Remote Turso: libsql://dbname-org.turso.io
DATABASE_URL="file:.turso/local.db"
DATABASE_AUTH_TOKEN=""

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
ADMIN_PASSWORD="change-me"

# Cron job secret (required for /api/cron/* endpoints)
CRON_SECRET="generate-a-random-36-char-string"

# GitHub OAuth (optional, for user login)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub PAT (optional, for sync-github cron — scopes: public_repo)
GITHUB_TOKEN=""

# Site URL (for RSS/JSON feeds, OG tags, sitemap)
SITE_URL="https://mcpservers.org"

# Email SMTP (optional, for digest notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="admin@example.com"

# Stripe (optional, for premium placements)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Sentry (optional, error tracking)
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
NEXT_PUBLIC_SENTRY_DSN=""

# GitHub sync batch config (optional, defaults shown)
# SYNC_BATCH_SIZE=50
# SYNC_CHUNK_DELAY_MS=1000
# SYNC_RATE_LIMIT_THRESHOLD=100
