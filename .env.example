# Database
# PGLite local directory (used when no external DATABASE_URL is configured)
DATABASE_DIR=""
# External PostgreSQL (required for Vercel serverless — use Neon/Supabase/Vercel Postgres)
# Example: postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=""

# NextAuth v5
AUTH_SECRET="your-secret-key-here"
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Admin credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin123"

# GitHub OAuth (for login)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub Personal Access Token (for API features: auto-fill, stars/forks sync)
# Create at: Settings → Developer settings → Personal access tokens → Tokens (classic)
# Required scopes: public_repo (read public repositories)
GITHUB_TOKEN=""

# Email (SMTP for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
ADMIN_EMAIL="admin@example.com"

# Stripe (for premium placements)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Sentry error tracking
# Get DSN from: https://sentry.io/settings/projects/YOUR_PROJECT/keys/
# Org and project slug needed for source maps upload (optional)
SENTRY_DSN="https://...@sentry.io/..."
SENTRY_ORG="your-org"
SENTRY_PROJECT="mcpservers"
# Client-side DSN (falls back to SENTRY_DSN if not set)
NEXT_PUBLIC_SENTRY_DSN=""

# Cron job secret (optional, for /api/cron/* endpoints)
CRON_SECRET=""

# Site URL (for RSS/JSON feeds, Stripe success/cancel redirects)
SITE_URL="https://mcpservers.org"
